  number={1},
  pages={561-570},
  abstract={We present a finite-element analysis of the coupled electro-thermal behavior of a mm2-sized power DMOS device, with a focus on resolving μm-sized structures. For a reliable power technology, the predictions of current and temperature distributions under self-heating are vital for reaching long device lifetime. Two aspects of our approach are unique: First, we have integrated the active region of the DMOS into the finite-element program code as a nonlinear voltage and temperature dependent tripole, incorporating local biasing and temperature conditions. Second, to model small features like defects or process-induced imperfections in sufficient detail, we use the Nitsche-type nonmatching grid technique to include the substantially finer meshed microscale geometry. This allows us to study very local changes in temperature and biasing conditions, which are normally not accessible. The methodology is applied to a state-of-the-art power technology device with integrated current sensor to validate the methodology. Good agreement is found between results and experiments.},
  keywords={Mathematical model;Resistance heating;Finite element analysis;Iron;Convergence;Electric potential;DMOS;electro-thermal effects;finite-element methods;heat transfer;multiscale modeling;power semiconductor devices},
  doi={10.1109/TPEL.2016.2527690},
  ISSN={1941-0107},
  month={Jan},}@INPROCEEDINGS{8725279,
  author={Uskov, Vladimir L. and Bakken, Jeffrey P. and Aluri, Lavanya},
  booktitle={2019 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={Crowdsourcing-Based Learning: the Effective Smart Pedagogy for STEM Education}, 
  year={2019},
  volume={},
  number={},
  pages={1552-1558},
  abstract={Multiple innovative teaching and learning strategies, that strongly support the advanced technology-based education, emerged in recent years. However, there are no published data analytics and validated outcomes regarding how good those innovative teaching approaches support the main concepts of Smart Pedagogy. This paper presents the outcomes of the ongoing research, design and development project at the InterLabs Research Institute, Bradley University (Peoria, IL, USA) aimed to identify, analyze, test, implement and recommend various components of Smart Pedagogy for STEM education. Those components may include but are not limited to 1) learning- by-doing, active learning or experiential learning, 2) games-based learning and gamification of learning, 3) collaborative learning, 4) analytics-based learning, 5) flipped classroom, 6) crowdsourcing-based learning, 7) badging-based learning, and 8) productive failure-based learning. The obtained research outcomes about application of crowdsourcing-based learning in several STEM undergraduate and graduate courses are presented in this paper. Project outcomes undoubtedly demonstrate students' keen interest in active use of crowdsourcing-based learning in Sciences courses, in particular, and in highly technological Smart Pedagogy in STEM education, in general.},
  keywords={IP networks;Engineering education;Conferences;Hip;Crowdsourcing based learning;STEM education;smart pedagogy;formative and summative evaluation},
  doi={10.1109/EDUCON.2019.8725279},
  ISSN={2165-9567},
  month={April},}@INPROCEEDINGS{11574140,
  author={Schwarzbach, Lucas da Silva and Ribeiro, Luis Otoni and Rodrigues, Rafael Anselmo and Barwaldt, Regina},
  booktitle={2026 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={GuidePrompt-EDU: Leveraging Prompt Engineering to Integrate Generative AI into Pre-Service Teacher Education}, 
  year={2026},
  volume={},
  number={},
  pages={1-9},
  abstract={The growing presence of AI in education demands teacher training to integrate GenAI, a issue given the scarcity of educators and high dropout rates in teacher programs, especially in Mathematics. This research aimed to investigate GenAI’s potential in Basic Education, focusing on the initial training of Mathematics teachers through the development and validation of the GuidePrompt-EDU. The guide is a prompt engineering adaptation, aligning commands with BNCC competences to offer a practical and pedagogically clear resource. The methodology, qualitative-quantitative and exploratory, involved the tool’s adaptation, an experimentation workshop, and pedagogical validation by specialists via a Likert questionnaire. Initial results indicated that, while participants recognized the clarity and utility of the GuidePrompt-EDU for planning Mathematics lessons, significant uncertainty was identified regarding its practical classroom application. The study concludes that the GuidePrompt-EDU is a promising proposal for critical GenAI integration into teacher training. It emphasizes the crucial need to deepen this formation, integrating theoretical discussions, pedagogical practices, and ethical aspects to ensure that future educators use technology in an autonomous and innovative way, aligned with contemporary demands.},
  keywords={Artificial intelligence;Printing;Training;Tools;Modeling;Conferences;Technology;Educational institutions;Bars;Planning;Generative AI;Basic Education;Teacher Training;Prompt Engineering},
  doi={10.1109/EDUCON67543.2026.11574140},
  ISSN={2165-9567},
  month={April},}@INPROCEEDINGS{10137793,
  author={Ramos, Marben S. and Barajas, John Raymond B. and Gealone, Pee Jay N. and Aspra, Nico O. and Padua, Oliver M. and Lucero, Arpon T.},
  booktitle={2023 Systems and Information Engineering Design Symposium (SIEDS)}, 
  title={Enhancing the Admissions Process for Engineering Baccalaureate Programs: A Machine Learning Approach to Developing a Valid and Reliable Examination}, 
  year={2023},
  volume={},
  number={},
  pages={191-196},
  abstract={This paper details an approach to identify multiple-choice questions that are most effective in discriminating deficiencies in mathematics competencies of incoming first-year engineering students who are graduates of the K-12 program that was recently implemented in the Philippines. To achieve this objective, machine learning algorithms such as the k-Nearest Neighbors (kNN), Logistic Regression (LR), Random Forest (RF), Decision Tree (DT), and Gradient Boosting Machines (GBM) were implemented. From a question bank containing 1,300 questions covering Algebra (A), Advanced Algebra (AA), Plane and Spherical Trigonometry (T), Analytic Geometry (AG), and Solid Mensuration (SM), five domain experts identified the suitability of the questions as part of a diagnostic examination in mathematics. Specifically, using a 5-point Likert scale (5 being the highest), the experts rated the suitability of each question to test the proficiency of a student in 23 mathematics competencies based on what is prescribed by the Commission on Higher Education (CHED). The collected survey data were then used to train the machine learning models, which extracted patterns to identify the questions that would be most suitable to test the mathematics competencies of incoming first-year engineering students. With a precision recall score of 99.90%, the LR model was selected as the best performing model and analysis of how the LR model predicts the labels through the use of shap values revealed that the preference was given towards questions which test student proficiency in foundational mathematics competencies like that of Algebra and Analytical Geometry. Overall, these findings provided a better understanding of the questions that are most effective in discriminating student deficiencies in mathematics subjects.},
  keywords={Geometry;Surveys;Analytical models;Algebra;Predictive models;Solids;Reliability engineering},
  doi={10.1109/SIEDS58326.2023.10137793},
  ISSN={},
  month={April},}@ARTICLE{11288074,
  author={Jat, Chandra Kant and Puricelli, Francesco Giacomo and Beerten, Jef and Ergun, Hakan and Van Hertem, Dirk},
  journal={IEEE Transactions on Power Systems}, 
  title={Unified Power Flow Model for Bipolar HVDC Grids in Unbalanced Operation}, 
  year={2026},
  volume={41},
  number={3},
  pages={2005-2017},
  abstract={In the near future, point-to-point High Voltage Direct Current (HVDC) systems are expected to evolve into multi-terminal and meshed HVDC grids, predominantly adopting a bipolar HVDC configuration. Normally, bipolar HVDC systems operate in balanced mode, i.e., near zero current flows through metallic or ground return. However, bipolar HVDC systems can also be operated in an unbalanced mode in case of a single converter pole or line conductor outage. A steady-state analysis of the unbalanced DC network requires solving a power flow problem including various converter control modes, as the steady-state behavior of the converters is governed by their control modes. This paper presents a comprehensive and unified power flow model for the balanced and unbalanced operation of bipolar HVDC grids, including various converter control modes on the AC and DC sides of the converters in a hybrid AC/DC system. It extends the basic control modes, developed for monopolar HVDC grids, to support the balanced as well as unbalanced operation of bipolar HVDC grids. Additionally, an AC-droop control, which defines a droop relationship between voltage magnitude and reactive power at the AC side of a converter, is incorporated into the modeling of bipolar HVDC systems. The functionality of the proposed model is demonstrated through a test case, and the power flow results are validated using PSCAD simulations. The impact of converter control modes on post-contingency system states is also investigated for single-pole contingencies. The proposed power flow model is implemented as an open-source tool using the Julia/JuMP framework. The accuracy and robustness of the model, as well as the developed tool, are demonstrated through large-scale test cases, including systems with up to 3,120 buses.},
  keywords={HVDC transmission;Load flow;Voltage control;Reactive power;Hybrid power systems;AC-DC power converters;Mathematical models;Contingency management;Load modeling;Convergence;AC/DC systems;bipolar HVDC;converter control;HVDC transmission;load flow;power flow;unbalanced HVDC;voltage source converter},
  doi={10.1109/TPWRS.2025.3641544},
  ISSN={1558-0679},
  month={May},}@ARTICLE{9766237,
  author={Kathirisetty, Nikhila and Jadeja, Rajendrasinh and Garg, Deepak and Thakkar, Hiren Kumar},
  journal={IEEE Access}, 
  title={On the Design of Student Assessment Model Based on Intelligence Quotient Using Machine Learning}, 
  year={2022},
  volume={10},
  number={},
  pages={48733-48746},
  abstract={The goal of this research is to figure out how to calculate academic achievements and students’ cognitive quotients for placement. This study will attempt to forecast students’ intelligence quotients or academic grades to measure the IQ of a student in a holistic manner using all kinds of parameters, from students’ academic records to input from their professors and even their family background, thus creating a dataset of 9000 instances with all these data. We implemented and trained multiple machine learning algorithms on the data and collected the outcomes to select the best algorithm. Students’ quantitative reasoning ability was selected as a parameter that could be assessed by their performance on aptitude tests. Certifications of the student during their bachelor’s degree have been considered, which would also give us an idea about the student’s critical and logical thinking ability. All the parameters were rated on a scale of 1-10. The driving motivation behind this investigation was to discover what parameters force a student to be placed in a company then the final overall “student score” is calculated to determine a student’s intelligence quotient. The final IQ score of the student-generated was graded on a scale of 0–3 and a suitable salary package range for the student was estimated giving the company a good idea of the student’s capability.},
  keywords={Companies;Support vector machines;Standards;Remuneration;Machine learning algorithms;Data mining;Reliability;Intelligence quotient (IQ);student assessment;academic performance;machine learning;data mining},
  doi={10.1109/ACCESS.2022.3171807},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10608558,
  author={Sengor, Ibrahim and Hayes, Barry P.},
  booktitle={2024 IEEE 22nd Mediterranean Electrotechnical Conference (MELECON)}, 
  title={Second Life Electric Vehicle Batteries for Stationary Energy Storage Applications: An Analysis of Technical and Economic Feasibility}, 
  year={2024},
  volume={},
  number={},
  pages={384-389},
  abstract={This paper provides a critical analysis of the state of the art of Second Life Batteries (SLBs) in stationary energy storage applications. A review of the recent literature is presented, focusing on the technical and economic feasibility of SLBs across a range of stationary storage applications. A case study of the Irish electricity grid is presented, evaluating the alignment of SLB availability with future market needs. This paper highlights the uncertain technical and economic viability of SLBs at grid scale. It emphasises the need for standardisation and improved understanding of SLB performance and reliability in second life applications. It was also observed that a growing number of studies showed higher total costs for SLBs compared to new batteries for stationary energy storage applications.},
  keywords={Renewable energy sources;Costs;Reviews;Focusing;Microgrids;Second Life;Batteries},
  doi={10.1109/MELECON56669.2024.10608558},
  ISSN={2158-8481},
  month={June},}@INPROCEEDINGS{9766786,
  author={Morocho-Lara, Daniel and Miranda-Ramos, Patricio and Neto-Chusín, Héctor and Iza-Pazmiño, Sarah},
  booktitle={2022 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={Collaborative tools web 3.0 in the teaching of mathematics in times of Covid 19 pandemic}, 
  year={2022},
  volume={},
  number={},
  pages={775-779},
  abstract={The limited use of collaborative tools in the teaching of Mathematics with students of Middle Basic General Education has allowed us to think about the three essential axes that this work entails: collaborative tools, Didactics of Mathematics, and learning and knowledge technologies (LKT). This research aimed to analyze the use of web 3.0 collaborative tools in the teaching of Mathematics. The methodology applied with a mixed experimental-exploratory approach, through a structured questionnaire of 24 questions on a Likert scale which was validated by Cronbach’s alpha statistic with a result of 0.846, the TAM model was applied to measure the acceptance of digital resources developed through collaborative web3.0 tools in virtual learning during the global pandemic covid-19, the ADDIE methodology was applied in the execution and application of collaborative tools for students in the eighth year of General Basic education. The contrast of the hypothesis was carried out using the Kolmogorov-Smirnov statistical test for a sample where a value less than 0.000 was obtained, stating that the development of web 3.0 resources by the teacher improves collaborative work focused on learning mathematics and, in this way, a paradigm shift is manifested in its conceptualization and modifications in its didactic development. The results show that the role of technology and the Internet in the learning of mathematics can generate some motivation, they represent for students and teachers a significant factor of high impact in the learning of mathematics in the long term, not because of their use or access to them, but for the competence to apply them in their learning.},
  keywords={COVID-19;Knowledge engineering;Pandemics;Collaborative tools;Education;Production;Mathematics;ICT;LKT;collaborative tools;didactics;mathematics teaching},
  doi={10.1109/EDUCON52537.2022.9766786},
  ISSN={2165-9567},
  month={March},}@INPROCEEDINGS{9794181,
  author={Gutfleisch, Marco and Schöps, Markus and Sayin, Sibel and Wende, Frederic and Sasse, Martina Angela},
  booktitle={2022 IEEE/ACM 44th International Conference on Software Engineering: Software Engineering Education and Training (ICSE-SEET)}, 
  title={Putting Security on the Table: The Digitalisation of Security Tabletop Games and its Challenging Aftertaste}, 
  year={2022},
  volume={},
  number={},
  pages={217-222},
  abstract={IT-Security Tabletop Games for developers have been available in analog format; with the COVID-19 pandemic, interest in collaborative remote security games has increased. In this paper, we propose a methodology to evaluate the impact of a (remote) security game-based intervention on developers. The study design consists of the respective intervention, three questionnaires, and a small open interview guide for a focus group. A validated self-efficacy scale is used as a proxy for measuring effects on participants’ ability to develop secure software. We tested this design with 9 participants (expert and novice developers and security experts) as part of a small feasibility study to understand the challenges and limitations of remote tabletop games. We describe how we selected and digitalised three security tabletop games, and report the qualitative findings from our evaluation. Setting up and running the virtual tabletop games turned out to be more challenging and complex for both moderator and participants than we expected. Completing the games required patience and persistence, and social interaction was limited. Our findings can be helpful in building and evaluating a better, more comprehensive, technically sound and issue-specific game-based training measure for developers. The methodology can be used by researchers to evaluate existing and new game designs.},
  keywords={Training;Privacy;Atmospheric measurements;Pandemics;Games;Particle measurements;Software;• Social and professional topics → Computing education;• Security and privacy → Software security engineering.},
  doi={10.1145/3510456.3514139},
  ISSN={},
  month={May},}@INPROCEEDINGS{11137444,
  author={Wulansari, Dhenika and Affandi, Achmad and Rachmadi, Reza Fuad},
  booktitle={2025 International Seminar on Intelligent Technology and Its Applications (ISITIA)}, 
  title={Decision Support System for Personnel Transfer Recommendation}, 
  year={2025},
  volume={},
  number={},
  pages={655-660},
  abstract={This study develops a Decision Support System (DSS) model to assist HR managers within the Directorate General of Customs and Excise (DJBC) in regional scope determining employee transfers based on predefined criteria and rules derived from regulations, expert opinions, and best practices. The DSS integrates Multi-Criteria Decision Making (MCDM) techniques, specifically the Technique for Order Preference by Similarity to Ideal Solution (TOPSIS), along with rule-based systems and profile matching to model employee transfer decisions. It classifies transfer eligibility, ranks destination offices, and provides the top three recommended locations. Validation through black-box testing confirms $\mathbf{1 0 0 \%}$ accuracy for rule-based processing, while evaluation of 92 employee assessment samples using Slovin's method aligns with manual profile matching results. The ranking of suggested transfer destinations is perceived as appropriate by HR managers. Usability testing using the System Usability Scale (SUS) yields a score of 70, indicating favourable usability. The DSS model is recommended for integration into personnel systems with expanded variables and rules.},
  keywords={Decision support systems;Seminars;Closed box;Manuals;Regulation;MCDM;Personnel;Usability;Best practices;Testing;decision support system;employee transfer;profile matching;rule-based system;TOPSIS},
  doi={10.1109/ISITIA66279.2025.11137444},
  ISSN={2769-5492},
  month={July},}@INPROCEEDINGS{10763637,
  author={Mohanty, Sasmita and Samal, Laxmipriya and Samal, Debashisa and Routray, Sudhir K.},
  booktitle={2024 IEEE International Conference on Communication, Computing and Signal Processing (IICCCS)}, 
  title={5G Managed Services Induced Changes in Telecom Value Chain}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper analyzes the transformative influence of managed services on the telecommunications value chain amidst the arrival of 5G technology. Managed services have assumed multifaceted roles within contemporary telecom markets, reshaping the value chain significantly over the past decades. However, their significance in the 5G era surpasses that of preceding mobile generations, endowing network vendors with increased authority. The evolution is primarily attributed to the introduction of novel technologies and provisions inherent in 5G networks. Unlike previous generations, network operators find themselves unable to independently construct their 5G infrastructure, thereby shifting the strategic landscape in favour of vendors. This paradigm shift underscores the pivotal role of specialized vendors in optimizing 5G networks to address the unique challenges posed by this high-speed, low-latency technology. Managed services integration in 5G heralds a paradigmatic shift in telecom value chains, revolutionizing network design, deployment, and maintenance methodologies. In addition to traditional responsibilities, managed service providers now contribute to network security, proactive monitoring, and dynamic optimization, ensuring heightened reliability and efficiency. This transformative impact empowers vendors to navigate the complex telecom landscape and unlock the full potential of 5G technologies.},
  keywords={Technological innovation;5G mobile communication;Shape;Signal processing;Telecommunications;Telecommunication computing;Outsourcing;Telecommunication network reliability;Research and development;Optimization;5G;managed services in 5G;telecom value chain;impact of managed services on telecom value chain},
  doi={10.1109/IICCCS61609.2024.10763637},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11256293,
  author={Petro, J. Rajkamal and Eastro, J. Jinikamal},
  booktitle={2025 World Engineering Education Forum - Global Engineering Deans Council (WEEF-GEDC)}, 
  title={Psychological and Behavioral Implications of Intellectual Humility}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Intellectual humility (IH), broadly defined as the recognition and acceptance of one's cognitive limitations and the willingness to revise beliefs in light of new evidence, has garnered increasing attention within psychological science for its potential role in shaping epistemic, social, and behavioral outcomes. Though historically rooted in philosophical discourse, IH has evolved into a distinctive psychological construct, encompassing cognitive, affective, and behavioral dimensions that hold considerable relevance for individual functioning and group dynamics. This study integrates a comprehensive theoretical synthesis with empirical investigation to elucidate the psychological architecture of IH and explore its practical implications, particularly within academic and professional contexts. The research employed a dual-method approach: a critical review of interdisciplinary literature including cognitive psychology, personality theory, and virtue epistemology to map the conceptual terrain of IH, followed by an empirical component comprising quantitative data $(\mathrm{N}=40)$ gathered through validated IH measures and qualitative insights from semi-structured interviews ($\mathrm{n}=40$). Statistical analyses, including structural equation modelling and correlational assessments, revealed that IH is positively associated with openness to experience and perspective-taking, while inversely correlated with dogmatism and overconfidence. Exploratory and confirmatory factor analyses confirmed a multidimensional framework, integrating elements of intellectual modesty, awareness of intellectual fallibility, and willingness to engage with dissenting views. The results underscore the value of cultivating IH through targeted interventions in educational and organizational settings, where it may foster ethical reasoning, epistemic responsibility, and constructive dialogue across ideological divides. This research provides a foundational step toward the operationalization of IH as a measurable and malleable trait with implications for enhancing individual selfregulation and promoting collective intelligence},
  keywords={Training;Statistical analysis;Reviews;Navigation;Scholarships;Psychology;Mathematical models;Rigidity;Interviews;Programming profession;Intellectual humility;cognitive psychology;epistemic virtue;personality traits;behavioral science},
  doi={10.1109/WEEF-GEDC66748.2025.11256293},
  ISSN={2837-5025},
  month={Sep.},}@ARTICLE{11224829,
  author={Kouraichi, Maher and Mansouri, Majdi and Trabelsi, Mohamed and M’Halla, Anis and Abdel-Khalik, Ayman S. and Sakly, Anis},
  journal={IEEE Access}, 
  title={Deep Learning for Fault Diagnosis in Power Transmission Lines: Current Trends, Limitations, and Future Directions}, 
  year={2025},
  volume={13},
  number={},
  pages={192105-192142},
  abstract={The resilience and efficiency of power transmission systems are essential to the stability of modern electrical grids, especially as these grids evolve with high penetrations of renewables and power electronics-based converters. Traditional fault detection and diagnosis (FDD) methods are increasingly challenged by the complexity, variability, and real-time demands of next-generation power networks. In this context, deep learning (DL) has emerged as a powerful tool, capable of extracting latent features from raw, high-dimensional data and offering robust, automated fault analysis. This paper surveys recent progress in DL-based fault diagnosis for transmission lines, with a focus on key neural architectures including convolutional neural networks (CNNs), recurrent networks (LSTM/GRU), attention mechanisms, and generative models. We explore how preprocessing, feature engineering, and data-driven model design impact diagnostic accuracy and generalization. The review also highlights hybrid approaches that combine signal processing with DL models, enabling enhanced interpretability and fault discrimination. Major research challenges such as limited labeled data, rare fault type detection, model robustness, and real-time deployment constraints are critically analyzed. Furthermore, we explore novel directions including self-supervised learning, transfer learning, edge deployment, and privacy-preserving federated learning tailored to smart grid ecosystems. This review aims to serve as a roadmap for advancing intelligent, scalable, and adaptive FDD systems in the era of digitalized power transmission networks.},
  keywords={Circuit faults;Power transmission lines;Fault diagnosis;Feature extraction;Reviews;Fault detection;Principal component analysis;Deep learning;Reliability;Federated learning;Fault detection and diagnosis (FDD);power transmission lines;deep learning;smart grids;feature engineering;neural networks;real-time monitoring;edge AI},
  doi={10.1109/ACCESS.2025.3628908},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{6826106,
  author={Silapachote, Piyanuch and Srisuphab, Ananta},
  booktitle={2014 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={Gaining and maintaining student attention through competitive activities in cooperative learning A well-received experience in an undergraduate introductory Artificial Intelligence course}, 
  year={2014},
  volume={},
  number={},
  pages={295-298},
  abstract={Digital-age undergraduate students exhibit a very short attention span, which is rapidly diminishing even further, posing a critical concern to today's academic community. This presents an immediate need for a non-traditional teaching and learning approach that is well-adapted to their diverse modern life-style. Instead of lectures only, interactive in-class activities do attract some attention, but do not guarantee to retain this focus. Maintaining students' attention, keeping them concentrated while they are studying, is no less of a crucial dilemma. It is therefore the focus of this research. Working in small groups is engaging and fun but students may easily move off-topic when a task is slightly complex or demanding. To overcome this, we are incorporating challenging elements, featuring built-in competitiveness into every cooperative activity and exercise we organize in our classroom, an introduction to Artificial Intelligence (AI). Exploiting the strong competitive nature of college students allows us to securely capture their full attention. Our students continue enjoying the activities, collectively focusing their efforts on given tasks, and undertaking assigned projects. As a consequence, and often without realizing it, they are learning new concepts first-hand with real examples. To evaluate the effectiveness of our methodology, students completed a questionnaire with targeted questions. Their feedback provides a strong positive validation of the approach taken.},
  keywords={Artificial intelligence;Games;Search problems;Educational institutions;Computer science;Engineering education;short attention span;competitive classroom activity;cooperative learning;co-teaching},
  doi={10.1109/EDUCON.2014.6826106},
  ISSN={2165-9567},
  month={April},}
