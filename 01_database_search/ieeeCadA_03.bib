  volume={},
  number={},
  pages={1-6},
  abstract={Anticipatory thinking, understood as the ability to project future scenarios based on prior experiences, is a key competency in contemporary education. This study analyzes how it is manifested in undergraduate students during the design of future scenarios, and how it relates to physiological responses in an immersive environment. Electrodermal activity and emotional reactions were measured using a quantitative design with physiological sensors and emotional self-assessment instruments. Seventy-threestudents participated in three groups and developed scenarios in two phases: a theoretical stage and a practical stage in virtual reality. The results showed a relationship between electrodermal activity and moments of cognitive load, particularly during scenario analysis and adaptation. High motivation and concentration were reported during the virtual reality phase. Findings suggest that anticipatory thinking may generate measurable emotional engagement and can be reinforced through immersive pedagogical experiences. Future research should incorporate control groups and standardize methodological variables to strengthen validity and replicability.},
  keywords={Printing;Design methodology;Human factors;Stress;Displays;Instruments;Indexes;Indexing;Learning (artificial intelligence);Timing;Anticipatory Thinking;Neuroeducation;Electrodermal Activity},
  doi={10.1109/EDUNINE62390.2026.11547046},
  ISSN={},
  month={March},}@INPROCEEDINGS{11452979,
  author={Prasath N, Arun and Starlin, M. A. and Venkatesh, T. and Ashok, Gaddam and Vellingiri and V, Vivekanandhan},
  booktitle={2025 1st International Conference on Advancement in Futuristic Technologies (ICAFT)}, 
  title={AI-Based Adaptive Routing Protocols for IoT Wireless Sensor Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The significant rise in Internet of Things (IoT) application has compounded the implementation of Wireless Sensor Networks (WSNs) where efficient routing has been a thorn in the flesh because of limited energy, dense node population, and variable traffic environment. Traditional routing algorithms like LEACH and RPL offer base line solutions but usually cannot adjust to atypical energy distributions and dynamic changing topologies and results in untimely node demise and poor network competence. In this paper, an AI-based adaptive routing framework is proposed, which combines reinforcement learning in the dynamic choice of routes, fuzzy logic in energy-optimal decision-making, and deep neural networks in predicting the load of traffic. The model was applied in NS-3 where a network of 200 nodes was used on a 500 m x 500 m field, and the nodes initially started with an energy of 2 J each. The experimental findings indicated that the proposed protocol extended the network lifetime by 390 rounds more compared to LEACH, enhanced the ratio of packet delivery by 13 points, and decreased the average end to end delay by 176 ms in comparison with 242 ms. Such findings indicate that AI-based adaptivity supports a greater energy efficiency but also results in better reliability and responsiveness, which is why the method is appropriate in large-scale IoT applications.},
  keywords={Training;Wireless sensor networks;Adaptation models;Adaptive systems;Heuristic algorithms;Routing;Energy efficiency;Internet of Things;Artificial intelligence;Next generation networking;IoT;Wireless Sensor Networks;Adaptive Routing;Reinforcement Learning;Energy Efficiency},
