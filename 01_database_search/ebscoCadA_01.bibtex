 issn      = "25937650",
 journal   = "EAI Computing & Communication in Emerging Regions - CCER",
 keywords  = "Feasibility studies; Educational technology; Instructional systems design; Engineering Services; Teaching aids; Critical thinking; Electrical engineering education; Test reliability",
 pages     = "915-924",
