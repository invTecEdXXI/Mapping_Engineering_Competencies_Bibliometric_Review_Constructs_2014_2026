 journal   = "Experimental Technology & Management",
 keywords  = "Electric power system protection; Singular value decomposition; Overcurrent protection; Offshore wind power plants; Markov processes; Electric power transmission; Electric Bulk Power Transmission and Control",
 pages     = "177-187",
 note      = "",
}

@article{18917122520251002,
 abstract  = "The present study investigates the effectiveness of the Campus-to-Corporate (C2C) training program in enhancing employability skills and promoting inclusive opportunities among final-year engineering students, aligning with Sustainable Development Goal 10 (Reduced Inequalities). A mixed-methods research design was employed, integrating quantitative pre-test–post-test analysis and qualitative feedback to evaluate the program’s impact. Data were collected from 100 students through structured questionnaires administered before and after the C2C training. Quantitative data were analyzed using the paired sample t-test to measure improvement in students’ knowledge, communication, and employability competencies. The results revealed a significant increase in post-training mean scores (t(9) = 12.00, p < 0.001), with a large effect size (Cohen’s d = 3.79), indicating a substantial positive impact of the program. The mean improvement of 4.0 points (95% CI: 3.246–4.754) demonstrated that the C2C",
 author    = "S., AMALI THERESA and MOHANRAJ, K. and ALICE EVANGALINE JEBASELVI, C. and GOWRI MANOHARI, M. and SOWMYA, L. and SHEEBA MAYBELL, P.",
 number    = "null",
 title     = "TRANSFORMING POTENTIAL INTO PERFORMANCE: CAMPUS-TO-CORPORATE TRAINING AS A PATHWAY TO EQUALITY AND EMPLOYABILITY TO SUPPORT SDG 10.",
 volume    = "32",
