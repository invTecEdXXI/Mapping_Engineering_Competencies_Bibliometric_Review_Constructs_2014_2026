 journal   = "Revista Virtual Universidad Católica del Norte",
 keywords  = "EMOTIONAL intelligence; STATISTICAL significance; ENGINEERING students; SATISFACTION; DESIGN services; INDUSTRIAL engineering",
 pages     = "161-193",
