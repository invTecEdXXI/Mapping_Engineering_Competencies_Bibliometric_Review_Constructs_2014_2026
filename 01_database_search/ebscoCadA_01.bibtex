}

@article{18529202120250101,
 abstract  = "Esta investigación examinó los cambios en la inteligencia emocional a partir de la aplicación de una práctica gamificada, diseñada y validada en estudiantes de fase profesional de Ingeniería Industrial. Estudio cuasi experimental, transversal, en el que participaron 20 mujeres y 28 hombres de un programa de Ingeniería Industrial de la ciudad de Pereira. Se usó una ficha de datos sociodemográficos, el TMMS-24 (Trait Meta Mood Scale) y una encuesta de percepción. El diseño de la práctica fue sometido a validación de doce expertos, cuyos criterios de evaluación fueron: claridad descriptiva, correspondencia objetiva, coherencia, pertinencia y viabilidad. Se realizaron análisis descriptivos, comparación de medias (Wilcoxon), y se aplicó la práctica gamificada en cinco grupos. Los expertos estuvieron de acuerdo con el diseño de la práctica respecto a los criterios de evaluación a los que fue sometida. Las medidas pre y post indicaron diferencias estadísticamente significativas en la intelig",
 author    = "Quiroz-González, Eliana and Morales Grajales, Dahiana and Ospina-Cano, Sarah and Pinzón-Salazar, Sebastián",
 number    = "74",
 title     = "Inteligencia emocional en estudiantes universitarios de fase profesional: Diseño, validación y aplicación de una práctica gamificada.",
 volume    = "null",
 url       = "https://research.ebsco.com/plink/f3c37677-661a-39c4-9b5b-0df6e7a349da",
 year      = "2025",
