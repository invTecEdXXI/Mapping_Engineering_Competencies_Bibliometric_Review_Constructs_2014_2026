  booktitle={2020 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={Validation of instruments to measure social entrepreneurship competence. The OpenSocialLab project}, 
  year={2020},
  volume={},
  number={},
  pages={1338-1342},
  abstract={Education within universities should consider the promotion of training activities aimed at training people who are creative, innovative, enterprising and aware of their environment and needs. The purpose of this paper is to present the preliminary results of the piloting of three instruments for a methodological proposal aimed at measuring the level of mastery scaled by students of undergraduate and graduate courses, in terms of social entrepreneurship skills. Thus, the instruments were validated through various strategies such as expert judgement, non-participating observation, statistical validity and reliability. Furthermore, the piloting takes place within the framework of a mixed method, since the data collection instruments were the focus group, the questionnaire and the semi-structured interview. The sample participating in the validation was different, depending on the instrument piloted: focus group (n =5), questionnaire (n =98) and interview (n =4). Finally, the contributions of this work can be of value in studying social entrepreneurship.},
  keywords={Training;Ethics;Instruments;Entrepreneurship;Data collection;Particle measurements;Reliability;social entrepreneurship;educational innovation;competence;students;measurement},
  doi={10.1109/EDUCON45650.2020.9125382},
  ISSN={2165-9567},
  month={April},}@INPROCEEDINGS{9612515,
  author={Gallardo-Pastor, Lupe Y. and Yacila, Jhair and Poémape, Aracelli},
  booktitle={2021 International Symposium on Accreditation of Engineering and Computing Education (ICACIT)}, 
  title={Perception of the undergraduate student about utility of numerical modelling techniques as a didactic resource for scientific research in Civil Engineering}, 
  year={2021},
  volume={},
  number={},
  pages={1-5},
  abstract={Teaching-learning in civil engineering research courses is a challenge and even more in the current context of the Covid 19 pandemic, taking into account that laboratories and field works are not available. Nevertheless, it is also an opportunity to optimize the use of didactic and technological resources that enable the students to use approaches to study different kinds of engineering problems as well as contributing to their development as researchers. This study allowed to collect, through a validated questionnaire, the perception of 148 students who were in the last year in the Civil Engineering career at the Universidad Privada del Norte, and the results revealed that 61% of them were “in agreement” with the usefulness of numerical modelling techniques as a teaching resource for research.},
  keywords={Knowledge engineering;Pandemics;Computational modeling;Education;Laboratories;Tools;Software;Student perception;Numerical modelling techniques;Scientific research},
  doi={10.1109/ICACIT53544.2021.9612515},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11355040,
  author={Santiyadnya, Nyoman and Divayana, Dewa Gede Hendra and Sukawijana, I Komang Gede and Andayani, Made Susi Lissia and Ariawan, I Putu Wisna and Erawati, Ni Ketut},
  booktitle={2025 9th International Conference on Information Technology, Information Systems and Electrical Engineering (ICITISEE)}, 
  title={Design of a Matundan-Based Digital Test Application Database as an Effort to Realize a Tool for Measuring Students' Critical Thinking Skills}, 
  year={2025},
  volume={},
  number={},
  pages={382-387},
  abstract={This study aims to demonstrate the design of a digital test application database based on the Matundan concept. The Borg and Gall model is used as a development model in this study. The development stages referring to the Borg and Gall model in this 2025 study only focus on the development stage of the database design, initial trials, and revisions to the results of the initial trials. The subjects involved in obtaining data from the initial trials of the digital test application database design based on the Matundan concept were 42 respondents. These respondents included: one informatics expert, one education expert, and the assessment of 10 lecturers and 30 students. The data collection tool for the initial trials was a questionnaire. The data analysis technique for this study was by comparing the results of the initial trials of the digital test application database design based on the Matundan concept with quality standards based on a five scale. The results of this study demonstrate the quality of the digital test application database design based on the Matundan concept falls into the good category. The impact of this research is the transformation of conventional assessment tools into digital assessments as a form of innovation in evaluation research, the existence of an operational framework that maps each Matundan stage into the specific difficulty level of each question item in the digital test application, and the existence of a track record of student development from basic to advanced levels with neatly stored data details.},
  keywords={Electrical engineering;Technological innovation;Databases;Education;Electric variables measurement;Data collection;Reliability;Information technology;Informatics;Standards;Database Design;Digital Test Application;Matundan;Measurement Tools;Critical Thinking Skills},
  doi={10.1109/ICITISEE68184.2025.11355040},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{7474686,
  author={Edalatifard, Homa and Prieto, Elena},
  booktitle={2016 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={Teaching academics' self-efficacy in curriculum change}, 
  year={2016},
  volume={},
  number={},
  pages={1071-1076},
  abstract={In response to the dramatic change in the Computing area, the continuous need for change and updating Computing curriculum is highlighted frequently in the relevant literature. Teaching academics play a key role in curriculum change process as they are the implementers of change. Whatever decision regarding curriculum change is made at a higher level, teaching academics will make it successful by putting them into practice. Academics with high self-efficacy are more likely to make efforts to be involved in curriculum change than those with low self-efficacy. The focus of this study was to investigate the Computing teaching academics' self-efficacy in curriculum change. The outcome of the study demonstrated some factors such as rewards and leadership need more attention to improve teaching academics' self-efficacy.},
  keywords={Technological innovation;Australia;Engineering education;Couplings;Industries;Teamwork;Engineering Education;teaching academics;curriculum change;self-efficacy},
  doi={10.1109/EDUCON.2016.7474686},
  ISSN={2165-9567},
  month={April},}@INPROCEEDINGS{9616631,
  author={Nurmalasari, Riana and Marsono and Mahamad, Abd Kadir},
  booktitle={2021 7th International Conference on Electrical, Electronics and Information Engineering (ICEEIE)}, 
  title={Contribution of Job Readiness Application and Student Competency Towards Job Readiness and Job Opportunities in Industry}, 
  year={2021},
  volume={},
  number={},
  pages={1-4},
  abstract={This study aims to see the contribution of Job Readiness Applications and student competency towards job readiness and job opportunities in industry through direct and indirect causal relationships. This research design used a quantitative approach with 4 variables consisting of 3 exogenous variables and 1 endogenous variable. The population of this study amounted to 260 mechanical engineering students. The sample size was determined using a random number table with an error rate 5%. So that a sample is 164 mechanical engineering students was obtained. Data collection using a questionnaire that uses a Likert scale. The validation of the instrument used the validity and reliability tests. The prerequisite analysis test used the normality, linearity, multicollinearity, autocorrelation, and heteroscedasticity test. The analysis model of the relationship pattern between variables used is path analysis. Testing is carried out simultaneously and individually. Based on the analysis, it can be concluded into 7 conclusions. First, Job Readiness Applications contribute significantly to job opportunities in the industry, directly by 13.54% and indirectly by 19.89%. Second, there is a significant contribution of student competence to job opportunities in the industry, directly by 13.91% and indirectly by 18.49%. Third, job readiness has a 5.24% direct contribution to job opportunities in the industry. Fourth, Job Readiness Applications contribute 11.56% directly to job readiness. Fifth, student competence contributes directly to job readiness by 6.1%. Sixth, there is a 24.4% direct contribution between Job Readiness Applications and student competence on job readiness. Seventh, there is a 57.6% direct significant contribution between Job Readiness Applications, student competence, and job readiness to industry job opportunities.},
  keywords={Industries;Error analysis;Instruments;Sociology;Linearity;Data collection;Reliability;job readiness applications;student competency;job readiness;job opportunities;industry},
  doi={10.1109/ICEEIE52663.2021.9616631},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{8658990,
  author={Jackson, Kathy L. and Blair, Jordan C. E. and Kremer, Gül E. and Wu, Xinli},
  booktitle={2018 IEEE Frontiers in Education Conference (FIE)}, 
  title={Instrument Development to Assess Design Project Appropriateness for Domain Relatedness, Ambiquity Tolerance, and Genderedness}, 
  year={2018},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents preliminary results of a currently funded NSF project that is developing and validating an instrument to assess the relationship between project appropriateness in domain relatedness, ambiguity, and genderedness and student efficacy in first-year engineering design courses. Because design is a defining activity for engineers, it is widely adopted as a means to introduce students to engineering. Many engineering schools now have first-year engineering courses, which feature engineering design learning in team-based settings. From a student's perspective, motivation and self-efficacy may decrease when (1) the project domain (e.g., electrical engineering) is not directly related to their chosen major (e.g., chemical engineering), (2) the projects are perceived to be overly complex and ambiguous vis-à-vis student preparation, and (3) skewed toward a particular gender (e.g., masculine or feminine oriented). With this work, we aim to assist engineering design instructors in refining content to achieve higher retention rates.},
  keywords={Instruments;Task analysis;Aerospace engineering;Loading;Chemical engineering;Springs;Eigenvalues and eigenfunctions;industry-sponsored projects;engineering design education;project appropriateness;instrument development},
  doi={10.1109/FIE.2018.8658990},
  ISSN={2377-634X},
  month={Oct},}@INPROCEEDINGS{8549753,
  author={Elmunsvah, Hakkun and Nur Hidayat, Wahyu and Patmantara, Syaad},
  booktitle={2018 International Seminar on Application for Technology of Information and Communication}, 
  title={Digital Literacy Skills of Informatics Engineering Education Students as the Basis for Online Learning Implementation}, 
  year={2018},
  volume={},
  number={},
  pages={257-260},
  abstract={Learning in the century of knowledge means that each individual can learn anywhere, anytime, with anyone, and through any media. The existing of technological developments are also ready to support the implementation of these online learning in desktop, web and mobile. With optimal utilization of ICT, it is hoped that learning can take place more attractive, real, and fun. The next problem that needs to be prepared is the assurance of digital literacy skills learners as the basis of the online learning application. Therefore, this research will be studied to the digital literacy skills of informatics engineering education students at Universitas Negeri Malang which are focused on the ability of information literacy, media literacy, and computer literacy. The research method is descriptive analysis with 99 respondents. The results of this study shows that the level of information literacy and media literacy students are in good category with the average value of 74,25% and 72,75%, while tech literacy ability is in very good category with the average value 83,75%. Based on these results it can be concluded that IT students have good literacy skills and can be improved through online and web-based learning.},
  keywords={Media;Instruments;Informatics;Industries;Engineering education;Internet of Things;digital literacy skills;online learning;ICT},
  doi={10.1109/ISEMANTIC.2018.8549753},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11096498,
  author={Peswani, Rakhi and Vijay, Priyanka},
  booktitle={2025 4th International Conference on Computational Modelling, Simulation and Optimization (ICCMSO)}, 
  title={Understanding the Influence of Demographics and Stream of Education on Cybercrime Awareness Among Students in Rajasthan, India}, 
  year={2025},
  volume={},
  number={},
  pages={213-218},
  abstract={Cybersecurity Literacy and Digital Financial Behavior among College Students in Rajasthan 3 The study aims at examining the cybersecurity literacy and digital financial behavior among the college students in Rajasthan (India) in the context of demographic variables like gender, educational stream, institutional exposure, and perception. Based on a questionnaire-based survey of 321 responses, the study uses descriptive statistics, regression, ANOVA, chisquare, and factor analysis to evaluate important variables such as the exposure to training, perceived effectiveness of curriculum, and the trust in digital tools. Results showed a moderate level of knowledge regarding cyber security, with the training and academic responses slightly improving the awareness level. Significant gender differences were found, with a more mixed pattern of effects by stream. A factor analysis yielded two latent constructs, curriculum-based consciousness and personal acquaintance. Despite educational deficits, the trust of students in Digital Knowledge Transfer was high-possible over confidence. Limitations of the study include a self-reported sample from one state and crosssectional design. However, it provides some useful insights from the lens of policymakers and educators in arguing for inclusive curriculum-integrated cybersecurity education to address digital risk resilience among youth in the emerging market context.},
  keywords={Training;Surveys;Navigation;Computer crime;Analysis of variance;Optimization;Knowledge transfer;Testing;Resilience;Lenses;Cybersecurity literacy;digital financial behaviour;college students;cybersecurity training;trust in digital platforms;gender disparities;statistical analysis;India;factor analysis;education policy},
  doi={10.1109/ICCMSO67468.2025.00045},
  ISSN={},
  month={June},}@INPROCEEDINGS{11547087,
  author={Garay-Rondero, Claudia Lizette and Palma-Mendoza, Jaime and Lemus-Aguilar, Isaac and Montesinos, Luis},
  booktitle={2026 IEEE Engineering Education World Conference (EDUNINE)}, 
  title={Integrating International Research and Challenge Based Learning Experience in Education 5.0}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This study analyses the integration of Research-Based Learning and Challenge-Based Learning within a Competency-Based Education framework to enhance engineering students' complex-thinking competency in the context of Industry 5.0. The research involved a six-month international internship in which students from Mexico collaborated with a Spanish additive manufacturing research group focused on healthcare innovation. This qualitative case study employed methodological triangulation to assess students' subcompetencies in systemic, critical, and scientific thinking using the validated eComplex rubric, faculty observations, descriptive statistics derived from research deliverables, and qualitative student feedback on mentoring. Findings indicate that the proposed model fosters analytical, reflective, and innovation-oriented capacities, reinforcing human-centred and sustainable learning outcomes consistent with Education 5.0 and the challenges of Industry 5.0.},
  keywords={Learning (artificial intelligence);Modeling;Printing;Fifth Industrial Revolution;Technological innovation;Technology;Engineering education;Context;Hospitals;Medical services;Research-Based Learning;Experiential Learning;Competency-Based Education;Engineering Education;Additive Manufacturing;3D Printing;Industry 5.0},
  doi={10.1109/EDUNINE62390.2026.11547087},
  ISSN={},
  month={March},}@ARTICLE{9694457,
  author={Chonsalasin, Dissakoon and Khampirat, Buratin},
  journal={IEEE Access}, 
  title={The Impact of Achievement Goal Orientation, Learning Strategies, and Digital Skill on Engineering Skill Self-Efficacy in Thailand}, 
  year={2022},
  volume={10},
  number={},
  pages={11858-11870},
  abstract={Rapid technological changes in industry and institutions of higher education required that their continuous learning and teaching methods conform to the needs of the labor market in the digital era. Building the engineering skill self-efficacy of students should be a key goal for educational institutions as they develop necessary skills for future engineers. This work investigated structural factors influencing engineering skill self-efficacy by conducting a questionnaire survey among 1,316 engineering students in Thailand. Structural equation modeling was used to validate the proposed model. The research results indicated that engineering skill self-efficacy was contributed to digital skills, learning strategies, and achievement goal orientation. Learning strategies were predicted by achievement goal orientation, and they positively associated with digital skills. These empirical findings reflect a sustainable educational development structure for engineering education. The results may benefit educators by specifying methods of educational development and learning activity design and promoting pedagogical system to develop learners’ characteristics to enhance their engineering skill self-efficacy. Students can then be prepared with digital skills to apply to their further work, which will affect capacity building and the overall image of a country’s development.},
  keywords={Education;Employment;Knowledge engineering;Industries;Economics;Collaborative work;STEM;Achievement goal orientation;learning strategies;digital skills;engineering skill self-efficacy},
  doi={10.1109/ACCESS.2022.3146128},
