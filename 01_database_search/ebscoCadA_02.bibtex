 keywords  = "Student attitudes; Engineering students; Engineering instruments; Test reliability; Measuring instruments; Netherlands; Instruments and Related Products Manufacturing for Measuring, Displaying, and Controlling Industrial Process Variables; Other Measuring and Controlling Device Manufacturing; Other Electronic and Precision Equipment Repair and Maintenance",
 pages     = "180-186",
