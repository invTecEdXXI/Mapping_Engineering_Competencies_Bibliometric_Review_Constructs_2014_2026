 journal   = "Children & Youth Services Review",
 keywords  = "Industries; Labor market; Students; Teachers; Vocational education; Qualitative research; Judgment sampling; Government programs; Cross-sectional method; Indonesia; Vocational Rehabilitation Services; Colleges, Universities, and Professional Schools",
