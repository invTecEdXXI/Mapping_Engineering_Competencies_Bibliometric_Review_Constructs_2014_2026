	author = {Idkhan, A. Muhammad and Syam, Husain and {Sunardi} and Hasim, Abdul Hafid},
	year = {2021},
	keywords = {College Graduates, Communication Skills, Confirmatory factor analysis, EDUCATION, Education Work Relationship, Employment Potential, Engineering Education, Foreign Countries, Fundamental skills, GRADUATE EMPLOYABILITY, Job Skills, KNOWLEDGE, PERCEPTIONS, Personal management skills, PERSPECTIVE, Problem Solving, Self Management, Skill Development, Soft skill, Soft Skills, Teamwork, Teamwork skills, Thinking Skills},
	pages = {119--134},
	annote = {Times cited: 23 {\textbar} Funding: The Professor's Acceleration Program supports this research sourced from the Non-Tax State Revenue of Universitas Negeri Makassar in 2020 (Contract Number: 2406/UN36.11/LP2M/2020). {\textbar} Funding agency: [2406/UN36.11/LP2M/2020] {\textbar} WoS Accession: WOS:000709436400009},
