}

@article{sanchez-carracedo_education_2021,
	title = {Education for {Sustainable} {Development} in {Spanish} engineering degrees. {Case} study},
	volume = {294},
	issn = {09596526},
	url = {https://www.scopus.com/pages/publications/85101173260?origin=resultslist},
	doi = {10.1016/j.jclepro.2021.126322},
	abstract = {The purpose of this work is to present a methodology for analyzing the perception of engineering students about the sustainability learning they have achieved during their university studies. This study has been carried out in the context of the Spanish university system. Specifically, the opinion of 3364 students from nine engineering degrees taught at three universities is analyzed. In the framework of the EDINSOST project, a questionnaire of 34 questions related to four sustainability competencies has been designed and validated. To measure the learning declared by the students, composite indicators have been constructed and validated using factor analysis. The results show that students consider that they have achieved only two thirds of the sustainability competencies they should have on completion of their studies (66.3\%). In the nine degrees, the worst results are obtained for the competency “application of ethical principles related to the values of sustainability”, in which the fourth-year students declare having achieved, on average, only 53\% of the expected learning outcomes. These results clearly show that engineering degrees should devote more time and effort to include Education for Sustainable Development in the curriculum. The methodology proposed in this work can be easily replicated in other contexts and in other countries. © 2021 Elsevier Ltd},
	language = {English},
	journal = {Journal of Cleaner Production},
	publisher = {Elsevier Ltd},
	author = {Sánchez-Carracedo, F. and Sureda, B. and Moreno-Pino, F.M. and Romero-Portillo, D.},
	year = {2021},
	keywords = {Composite indicators, Curricula, Education for sustainable development, Engineering degrees, Ethical principles, Expected learning outcomes, Planning, Spanish engineerings, Student's perceptions, Students, Sustainability competencies, Sustainability in engineering degrees, Sustainability learning, Sustainable development, University system},
	pages = {126322},
