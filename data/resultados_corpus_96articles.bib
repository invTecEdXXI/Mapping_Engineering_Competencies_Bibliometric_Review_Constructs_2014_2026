@article{arias-rueda_assessment_2025,
	title = {{ASSESSMENT} {OF} {GENERIC} {COMPETENCIES} {IN} {CIVIL} {ENGINEERING} {STUDENTS} {DURING} {PRE}-{PROFESSIONAL} {INTERNSHIPS}.},
	volume = {25},
	issn = {1695-324X},
	url = {https://research.ebsco.com/plink/8c8166a5-88c6-3b0c-85b5-6e83d6fc2efa},
	doi = {10.30827/eticanet.v25i1.32771},
	abstract = {Pre-professional internships are crucial in training civil engineering students, as they foster the development of generic competencies essential for professional success and workplace adaptability. This study assessed these competencies using a quantitative, descriptive, and correlational approach with a cross-sectional design through an adapted and validated Work Experience Questionnaire (WEQ) version. Ninety-five students from the seventh and eighth levels at Salesian Polytechnic University of Ecuador were surveyed, focusing on Clear Goals, Workplace Support, University Support, and Generic Competencies. The instrument's reliability was confirmed with high Cronbach's alpha values ({\textgreater}0.90), and exploratory (EFA) and confirmatory factor analyses (CFA) supported its structural validity. The findings revealed that Clear Goals (r = 0.867) and Workplace Support (r = 0.838) significantly influence the development of generic competencies. In contrast, University Support (r = 0.690) showed a moderate effect. The multiple regression analysis corroborated these results. This study highlights the need for an integrated academic and workplace environment to maximize the impact of internships on the training of future civil engineers. A collaborative approach between universities and companies would not only facilitate the alignment of learning objectives with the demands of the labour market. However, it would also allow students to receive more structured and continuous support during their practical experience.},
	language = {English},
	number = {1},
	journal = {ETIC NET},
	publisher = {UNIV GRANADA},
	author = {Arias-Rueda, Jhon Herminson and Arias-Rueda, César Augusto},
	year = {2025},
	keywords = {CIVIL engineers, CONFIRMATORY factor analysis, FIT INDEXES, LABOR market, MULTIPLE regression analysis, TEACHERS, TRAINING of engineers},
	pages = {216--240},
	annote = {Times cited: 0 {\textbar} WoS Accession: WOS:001513326100002},
	file = {Full Text PDF:E\:\\Zotero\\storage\\CJFH8DNR\\Arias-Rueda y Arias-Rueda - 2025 - ASSESSMENT OF GENERIC COMPETENCIES IN CIVIL ENGINEERING STUDENTS DURING PRE-PROFESSIONAL INTERNSHIPS.pdf:application/pdf},
}

@inproceedings{pinto_transferable_2023,
	title = {Do transferable skills matter for engineering students?},
	isbn = {979-835031581-3 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85171792976?origin=resultslist},
	doi = {10.1109/cispee58593.2023.10227618},
	abstract = {Transferable skills are becoming increasingly important, due to a progressively more competitive labor market in an ever-changing world. Particularly in the engineering sphere, it is even more obvious, as technical skills need transferable skills to have value. Increasing importance is being given by organizations and employers to transferable skills of their employees. Consequently, this study has two main goals: (1) analyze and determine how important engineering students consider transferable skills for their future career and (2) translate, adapt, and validate the Generic Skills Perception Questionnaire (GSPQ)-level of importance-for the Portuguese context. The scale was voluntarily answered by a sample of 219 engineering students from a Portuguese University. Descriptive measures were used to verify the perceived importance of the transferable skills of engineering students for their professional future. The scale GSPQ was validated for the Portuguese context through confirmatory factor analysis. Practical implications were drawn, namely the need to (re)structure the curricular units that are vital to a successful engineer development. © 2023 IEEE.},
	language = {English},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Pinto, Ana and Oliveira, Soraia and Carvalho, Carla},
	year = {2023},
	keywords = {Confirmatory factor analysis, Engineering profession, Engineering student, engineering students, Factor analysis, importance level for future career, Labour market, Organizations, Portuguese University, Professional aspects, Students, Technical skills, transferable skills},
	pages = {1--7},
