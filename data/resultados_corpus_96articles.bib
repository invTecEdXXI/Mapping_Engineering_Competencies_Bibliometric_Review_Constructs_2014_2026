Journal Abbreviation: Online Submission
Publication Title: Online Submission
Volume: 1},
	keywords = {Computer Science Education, Engineering Education, Factor Analysis, Foreign Countries, Programming, Rating Scales, Reliability, Self Efficacy, Validity},
	pages = {20--31},
