@inproceedings{lee_validity_2025,
	title = {Validity of a {Scale} to {Measure} {IC}-{PBL} {Learning} {Outcome} in {Engineering} {Education}},
	isbn = {979-833158879-3 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105030163468?origin=resultslist},
	doi = {10.1109/weef-gedc66748.2025.11256219},
	abstract = {Industry-Coupled Problem-Based Learning (IC-PBL) has become a central approach in engineering education, enabling students to bridge theoretical understanding with real-world application. In our prior work, we have developed a new measurement instrument to evaluate the outcome of IC-PBL engineering education in terms of Engineering problem solving, Communication and collaboration, and self-leadership. However, its validity and reliability were established only within a single institution. This study therefore extended the original scale to a multi-institutional sample of undergraduate engineering students(N = 1,195 across 7 universities) to assess its generalizability and to examine how learner characteristics influence IC-PBL outcomes. A second-order confirmatory factor analysis (CFA) was conducted to examine the construct validity of the scale. Following this, structural equation modeling (SEM) was used to analyze how individual characteristics-gender, academic year, prior IC-PBL experience, and enrollment in an IC-PBLactive university-predict student competencies. The analysis was based on responses from undergraduate students across multiple engineering institutions. The results confirmed the three-factor structure of IC-PBL learning outcomes and demonstrated that the scale is a valid tool for assessing student development. Academic year was found to be a consistent positive predictor across all competencies, indicating a developmental trend as students advance in their studies. Gender differences were observed only in communication and collaboration. Notably, prior IC-PBL experience significantly contributed to competency development, highlighting the value of repeated exposure to problem-based learning environments. Conversely, institutional IC-PBL activation level did not show a significant influence. This study offers empirical support for using the IC-PBL outcomes scale in engineering education and underscores the importance of sustained and high-quality IC-PBL instruction. Future research should explore how specific instructional designs enhance competency growth within IC-PBL contexts. © 2025 IEEE.},
	language = {English},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Lee, Youjin and Yi, Byung-Ju and Park, Hyun-mi and Lee, Hyejeong and Yang, JeongA and Park, Youngmi},
	year = {2025},
	keywords = {Collaboration, Communication and collaborations, Computer aided instruction, Coupled problems, Education computing, Engineering Education, Engineering problem solving, Engineering research, Factor analysis, IC-PBL, Industry-coupled problem-based learning, Instruments, Learning experiences, Learning outcome, Learning systems, Mathematical models, Measurements instruments, Monitoring, Numerical analysis, Problem based learning, Problem solving, Problem-based Learning, Problem-solving, Real-world, Reliability theory, Statistical analysis, Students, Trajectory},
	pages = {1--6},
	annote = {Times cited: 1},
}

@article{yang_study_2026,
	title = {A study on the stimulation and guidance of intrinsic motivation among engineering college students in {China}},
	volume = {11},
	issn = {2504-284X},
	url = {https://www.scopus.com/pages/publications/105028971303?origin=resultslist},
	doi = {10.3389/feduc.2026.1733781},
	abstract = {Background: Against the backdrop of rapid advancements in artificial intelligence and information technology, engineering university students face complex learning challenges. However, existing tools for measuring their intrinsic motivation—a crucial driver of learning—often lack cultural adaptability in the Chinese context, and systematic intervention strategies are scarce. Methods: Based on Self-Determination Theory and the Intrinsic Motivation Inventory, we developed and locally adapted the Chinese College Student’s Intrinsic Motivation Learning Questionnaire (CIMLQ), removing the less applicable “Relatedness” dimension. The final 30-item instrument covers six dimensions: Interest/Enjoyment, Perceived Competence, Effort, Pressure/Tension, Perceived Choice, and Value/Usefulness. Its reliability and validity were tested with 450 engineering students. Subsequently, a 19-week randomized controlled trial (N = 600) was conducted, comparing an experimental group receiving multidimensional motivation strategies (e.g., goal contracting, choice provision) with a control group under conventional instruction. Results: Exploratory and confirmatory factor analyses demonstrated good structural validity (cumulative variance explained: 66.13\%) and internal consistency (Cronbach’s α = 0.829–0.891). The teaching experiment revealed that the experimental group showed a significantly higher post-intervention intrinsic motivation score (119.20 vs. 97.81, *p* {\textless} 0.001, a 21.8\% increase) and better academic performance (80.10 vs. 76.57, *p* = 0.001) compared to the control group. Conclusion: The CIMLQ proves to be a reliable and valid measure for assessing intrinsic motivation among Chinese engineering students. The findings provide empirical evidence that structured instructional interventions, designed based on the CIMLQ dimensions, can effectively enhance both intrinsic motivation and academic outcomes. This study offers a practical framework for fostering self-directed learning capabilities that are essential for adapting to evolving educational environments. Copyright © 2026 Yang and Han.},
	language = {English},
	journal = {Front. Educ.},
	publisher = {FRONTIERS MEDIA SA},
	author = {Yang, K. and Han, D.},
	year = {2026},
	keywords = {ACHIEVEMENT, college student, intervention, intrinsic motivation, measurement, SCALE, SELF-DETERMINATION THEORY, testing},
	pages = {1733781},
	annote = {Times cited: 0 {\textbar} WoS Accession: WOS:001673827300001},
	file = {Full Text PDF:E\:\\Zotero\\storage\\UBKG9E7V\\Yang y Han - 2026 - A study on the stimulation and guidance of intrinsic motivation among engineering college students i.pdf:application/pdf},
}

