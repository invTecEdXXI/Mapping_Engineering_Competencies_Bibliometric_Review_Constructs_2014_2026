@inproceedings{schar_abet_2018,
	title = {{ABET} {Criterion} 3 as a {Measure} of {Engineering} {Self}-{Efficacy}: {Comparing} the {New} {Criteria} (3.1-7) to the {Previous} {Criteria} (3a-k)},
	volume = {2018-October},
	isbn = {15394565 (ISSN); 978-153861173-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85063501293?origin=resultslist},
	doi = {10.1109/fie.2018.8659226},
	abstract = {This Research to Practice Full Paper outlines the process of converting the ABET Criterion 3 - Student Outcomes into an engineering self-efficacy scale (ESE-ABET) and in this format compares the current ABET 3.1-7 items with the previous ABET 3a-k items with undergraduate engineering students. In total, survey responses were collected from undergraduate engineering students (n =561) attending five institutions ranging from larger public universities to smaller private universities. Mean comparison, correlation and regression suggests that the ABET Criterion 3 do make valid and reliable measure of overall 'engineeringness' self-efficacy and that self-efficacy scales based on ABET 3.1-7 and ABET 3a-k produce nearly identical results. Factor analysis and hierarchical clustering show that the ABET Criteria 3 items tend to form two groups - 'Technical Skills' and 'Professional Skills' - and this finding may make it easier to use the criteria as an organizing curricular structure and/or a measure of program effectiveness. Support was also found for a short form version (ESE-SF) of this scale when survey capacity is limited. A discussion of the value of having a valid and reliable ABET-based self-efficacy measure is included. © 2018 IEEE.},
	language = {English},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Schar, Mark and Brackin, Patsy and Chew, K. J. and Sheppard, Sheri},
	year = {2018},
	keywords = {ABET accreditation, ABET criteria, ABET criteria 3 - student outcome, ABET Criterion 3 - Student Outcomes, Accreditation, Curricula, Curriculum development, Economics, Engineering profession, Engineering self-efficacy measure, Engineering self-efficacy measures, Engineering students, Hier-archical clustering, Hierarchical clustering, Reliability, Self efficacy, Self-efficacy, Student outcomes, Students, Surveys, Task analysis},
	pages = {1--9},
	annote = {Times cited: 4},
	file = {Texto completo:E\:\\Zotero\\storage\\CDXUND93\\Schar et al. - 2018 - ABET Criterion 3 as a Measure of Engineering Self-Efficacy Comparing the New Criteria (3.1-7) to th.pdf:application/pdf},
